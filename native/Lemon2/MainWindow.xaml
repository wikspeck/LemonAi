<Window x:Class="Lemon2.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Lemon2" Title="Lemon">
 <Grid x:Name="Root" Background="{ThemeResource LemonBackground}" SizeChanged="Root_SizeChanged">
  <SplitView x:Name="Shell" DisplayMode="Inline" IsPaneOpen="True" OpenPaneLength="248" PaneBackground="{ThemeResource LemonSurface}">
   <SplitView.Pane><Grid Padding="16" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="10" Padding="10,12"><Path Style="{StaticResource LemonIcon}" Data="M5,7 C5,2 19,2 19,7 C24,8 22,21 15,21 C12,24 2,20 3,12 C1,9 3,6 5,7 Z M7,14 C8,9 12,7 17,8" Stroke="{ThemeResource LemonAccent}" Width="26" Height="26"/><TextBlock Text="lemon" FontSize="24" FontWeight="SemiBold"/></StackPanel>
    <Button x:Name="New" Grid.Row="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="New_Click"><StackPanel Orientation="Horizontal" Spacing="12"><Path Style="{StaticResource LemonIcon}" Data="M12,4 L12,20 M4,12 L20,12"/><TextBlock Text="{x:Bind Strings.NewChat,Mode=OneWay}"/></StackPanel></Button>
    <TextBox x:Name="Search" Grid.Row="2" PlaceholderText="{x:Bind Strings.Search,Mode=OneWay}" AutomationProperties.Name="{x:Bind Strings.Search,Mode=OneWay}" TextChanged="Search_TextChanged"/>
    <ListView x:Name="Chats" Grid.Row="3" DisplayMemberPath="Title" SelectionChanged="Chats_SelectionChanged" SelectionMode="Single" Background="Transparent" BorderThickness="0"><ListView.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="{x:Bind Strings.Rename,Mode=OneWay}" Click="Rename_Click"/><MenuFlyoutItem Text="{x:Bind Strings.Delete,Mode=OneWay}" Click="Delete_Click"/></MenuFlyout></ListView.ContextFlyout></ListView>
    <Button Grid.Row="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="Settings_Click"><StackPanel Orientation="Horizontal" Spacing="12"><Path Style="{StaticResource LemonIcon}" Data="M4,6 L20,6 M4,12 L20,12 M4,18 L20,18 M8,3 L8,9 M16,9 L16,15 M10,15 L10,21"/><TextBlock Text="{x:Bind Strings.Settings,Mode=OneWay}"/></StackPanel></Button>
   </Grid></SplitView.Pane>
   <Grid x:Name="ContentArea" Padding="24,12" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button Style="{StaticResource IconButton}" AutomationProperties.Name="{x:Bind Strings.Sidebar,Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Strings.Sidebar,Mode=OneWay}" Click="Sidebar_Click"><Path Style="{StaticResource LemonIcon}" Data="M4,6 L20,6 M4,12 L20,12 M4,18 L20,18"/></Button>
     <TextBlock x:Name="ConversationTitle" Grid.Column="1" Text="Lemon" VerticalAlignment="Center" FontSize="14" Foreground="{ThemeResource LemonMuted}" TextTrimming="CharacterEllipsis"/>
     <Button Grid.Column="2" Style="{StaticResource IconButton}" AutomationProperties.Name="{x:Bind Strings.Theme,Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Strings.Theme,Mode=OneWay}" Click="Theme_Click"><Path Style="{StaticResource LemonIcon}" Data="M12,3 A9,9 0 1 0 12,21 A9,9 0 1 0 12,3 M12,3 L12,21"/></Button>
     <Button Grid.Column="3" Style="{StaticResource IconButton}" AutomationProperties.Name="{x:Bind Strings.Fullscreen,Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Strings.Fullscreen,Mode=OneWay}" Click="Fullscreen_Click"><Path Style="{StaticResource LemonIcon}" Data="M4,9 L4,4 L9,4 M15,4 L20,4 L20,9 M20,15 L20,20 L15,20 M9,20 L4,20 L4,15"/></Button>
    </Grid>
    <Grid Grid.Row="1" MaxWidth="860" HorizontalAlignment="Stretch">
     <StackPanel x:Name="Welcome" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" Margin="16"><Path Style="{StaticResource LemonIcon}" Data="M5,7 C5,2 19,2 19,7 C24,8 22,21 15,21 C12,24 2,20 3,12 C1,9 3,6 5,7 Z M7,14 C8,9 12,7 17,8" Width="42" Height="42" Stroke="{ThemeResource LemonAccent}"/><TextBlock Text="{x:Bind Strings.Welcome,Mode=OneWay}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/><TextBlock Text="{x:Bind Strings.WelcomeDetail,Mode=OneWay}" Foreground="{ThemeResource LemonMuted}" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel>
     <ListView x:Name="Messages" SelectionMode="None" Background="Transparent" BorderThickness="0"><ListView.ItemTemplate><DataTemplate><StackPanel Spacing="10" Padding="4,16"><TextBlock Text="{Binding DisplayRole}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource LemonMuted}"/><local:CanvasView/><local:MessageView/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
    </Grid>
    <InfoBar x:Name="Status" Grid.Row="2" MaxWidth="860" IsOpen="False" IsClosable="True" Severity="Informational"><InfoBar.ActionButton><Button x:Name="ConnectButton" Content="{x:Bind Strings.Retry,Mode=OneWay}" Click="Connect_Click"/></InfoBar.ActionButton></InfoBar>
    <Grid Grid.Row="3" MaxWidth="860" HorizontalAlignment="Stretch" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="{ThemeResource LemonSurface}" BorderBrush="{ThemeResource LemonStroke}" BorderThickness="1" CornerRadius="16" Padding="12">
      <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBox x:Name="Composer" PlaceholderText="{x:Bind Strings.Compose,Mode=OneWay}" AutomationProperties.Name="{x:Bind Strings.Compose,Mode=OneWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxHeight="168" BorderThickness="0" Background="Transparent" KeyDown="Composer_KeyDown"/>
       <Grid Grid.Row="1" ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="ModelSummary" HorizontalAlignment="Left" MaxWidth="220" ToolTipService.ToolTip="{x:Bind Strings.Tier,Mode=OneWay}" AutomationProperties.Name="{x:Bind Strings.Tier,Mode=OneWay}"><StackPanel Orientation="Horizontal" Spacing="8"><Path Style="{StaticResource LemonIcon}" Data="M12,3 L21,8 L12,13 L3,8 Z M3,12 L12,17 L21,12 M3,16 L12,21 L21,16"/><TextBlock x:Name="TierLabel" Text="Zenith" FontSize="13" TextTrimming="CharacterEllipsis"/></StackPanel><Button.Flyout><Flyout><StackPanel Spacing="14" Width="280"><ComboBox x:Name="Tier" Header="{x:Bind Strings.Tier,Mode=OneWay}" SelectedIndex="1" HorizontalAlignment="Stretch" SelectionChanged="Tier_SelectionChanged"><ComboBoxItem Content="Vortex" Tag="vortex"/><ComboBoxItem Content="Zenith" Tag="zenith"/><ComboBoxItem Content="Apex" Tag="apex"/></ComboBox><ComboBox x:Name="Model" Header="{x:Bind Strings.Model,Mode=OneWay}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" SelectionChanged="Model_SelectionChanged"/></StackPanel></Flyout></Button.Flyout></Button>
        <Button Grid.Column="1" ToolTipService.ToolTip="{x:Bind Strings.Effort,Mode=OneWay}" AutomationProperties.Name="{x:Bind Strings.Effort,Mode=OneWay}"><StackPanel Orientation="Horizontal" Spacing="8"><Path Style="{StaticResource LemonIcon}" Data="M5,19 L5,14 M12,19 L12,9 M19,19 L19,4"/><TextBlock x:Name="EffortLabel" Text="{x:Bind Strings.Medium,Mode=OneWay}" FontSize="13"/></StackPanel><Button.Flyout><Flyout><StackPanel Spacing="12" Width="276"><TextBlock Text="{x:Bind Strings.Effort,Mode=OneWay}" FontWeight="SemiBold"/><Grid Background="{ThemeResource LemonSurface}" CornerRadius="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border x:Name="EffortIndicator" Grid.Column="1" Background="{ThemeResource LemonHover}" CornerRadius="8" Margin="3"><Border.Transitions><TransitionCollection><RepositionThemeTransition/></TransitionCollection></Border.Transitions></Border><Button Tag="low" Content="{x:Bind Strings.Low,Mode=OneWay}" Click="EffortChoice_Click"/><Button Grid.Column="1" Tag="medium" Content="{x:Bind Strings.Medium,Mode=OneWay}" Click="EffortChoice_Click"/><Button Grid.Column="2" Tag="high" Content="{x:Bind Strings.High,Mode=OneWay}" Click="EffortChoice_Click"/></Grid><TextBlock Text="{x:Bind Strings.ModelNote,Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource LemonMuted}"/><ComboBox x:Name="Effort" SelectedIndex="1" Visibility="Collapsed" SelectionChanged="Effort_SelectionChanged"><ComboBoxItem Tag="low"/><ComboBoxItem Tag="medium"/><ComboBoxItem Tag="high"/></ComboBox></StackPanel></Flyout></Button.Flyout></Button>
        <Button Grid.Column="2" ToolTipService.ToolTip="{x:Bind Strings.Format,Mode=OneWay}" AutomationProperties.Name="{x:Bind Strings.Format,Mode=OneWay}"><Path Style="{StaticResource LemonIcon}" Data="M4,4 L20,4 L20,20 L4,20 Z M4,10 L20,10 M11,10 L11,20"/><Button.Flyout><Flyout><ComboBox x:Name="OutputMode" Width="250" Header="{x:Bind Strings.Format,Mode=OneWay}" SelectedIndex="1" HorizontalAlignment="Stretch"><ComboBoxItem Content="{x:Bind Strings.Text,Mode=OneWay}" Tag="text"/><ComboBoxItem Content="{x:Bind Strings.Markdown,Mode=OneWay}" Tag="markdown"/><ComboBoxItem Content="{x:Bind Strings.Canvas,Mode=OneWay}" Tag="canvas"/></ComboBox></Flyout></Button.Flyout></Button>
        <Grid Grid.Column="3"><Button x:Name="Stop" Style="{StaticResource IconButton}" Visibility="Collapsed" IsEnabled="False" Click="Stop_Click" AutomationProperties.Name="{x:Bind Strings.Stop,Mode=OneWay}"><Path Style="{StaticResource LemonIcon}" Data="M6,6 L18,6 L18,18 L6,18 Z"/></Button><Button x:Name="Send" Style="{StaticResource IconButton}" Click="Send_Click" AutomationProperties.Name="{x:Bind Strings.Send,Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Strings.Send,Mode=OneWay}"><Path Style="{StaticResource LemonIcon}" Data="M12,20 L12,4 M5,11 L12,4 L19,11" Stroke="{ThemeResource LemonAccent}"/></Button></Grid>
       </Grid>
      </Grid>
     </Border>
     <Grid Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="Regenerate" Style="{StaticResource IconButton}" Click="Regenerate_Click" AutomationProperties.Name="{x:Bind Strings.Regenerate,Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Strings.Regenerate,Mode=OneWay}"><Path Style="{StaticResource LemonIcon}" Data="M20,9 A8,8 0 1 0 19,17 M20,3 L20,9 L14,9"/></Button><TextBlock x:Name="ConnectionLabel" Grid.Column="1" Text="{x:Bind Strings.Connecting,Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource LemonMuted}" FontSize="12" TextTrimming="CharacterEllipsis"/></Grid>
    </Grid>
   </Grid>
  </SplitView>
 </Grid>
</Window>

