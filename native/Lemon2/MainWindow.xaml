<Window x:Class="Lemon2.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Lemon2" Title="Lemon">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" SizeChanged="Root_SizeChanged">
  <Grid.Resources>
   <Style TargetType="Button"><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="14,9"/></Style>
   <Style TargetType="TextBox"><Setter Property="CornerRadius" Value="10"/></Style>
   <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8"/><Setter Property="CornerRadius" Value="10"/></Style>
  </Grid.Resources>
  <SplitView x:Name="Shell" DisplayMode="Inline" IsPaneOpen="True" OpenPaneLength="248" PaneBackground="{ThemeResource LayerFillColorDefaultBrush}">
   <SplitView.Pane>
    <Grid Padding="18" RowSpacing="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,10"><TextBlock Text="◒" Foreground="#87AD37" FontSize="28"/><TextBlock Text="lemon" FontSize="25" FontWeight="SemiBold"/></StackPanel>
     <Button x:Name="New" Grid.Row="1" Content="＋  Neuer Chat" HorizontalAlignment="Stretch" Click="New_Click"/>
     <TextBox x:Name="Search" Grid.Row="2" PlaceholderText="Chats suchen" TextChanged="Search_TextChanged" AutomationProperties.Name="Chats suchen"/>
     <ListView x:Name="Chats" Grid.Row="3" DisplayMemberPath="Title" SelectionChanged="Chats_SelectionChanged" SelectionMode="Single" Background="Transparent" BorderThickness="0">
      <ListView.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="Umbenennen" Click="Rename_Click"/><MenuFlyoutItem Text="Löschen" Click="Delete_Click"/></MenuFlyout></ListView.ContextFlyout>
     </ListView>
     <StackPanel Grid.Row="4" Spacing="8"><Button Content="Einstellungen" Click="Settings_Click" HorizontalAlignment="Stretch"/><TextBlock Text="Lemon 2.1 · Auf diesem Gerät" FontSize="12" Opacity="0.6" Margin="8,0"/></StackPanel>
    </Grid>
   </SplitView.Pane>
   <Grid Padding="24,16" RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button Content="☰" AutomationProperties.Name="Seitenleiste umschalten" Click="Sidebar_Click" Background="Transparent" BorderThickness="0"/>
     <Button x:Name="ModelSummary" Grid.Column="1" Content="Lemon 2.1  ⌄" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0">
      <Button.Flyout><Flyout><StackPanel Spacing="12" Width="280"><TextBlock Text="Dein Modell, dein Tempo" FontSize="20" FontWeight="SemiBold"/>
       <ComboBox x:Name="Tier" Header="Leistung" SelectedIndex="1" HorizontalAlignment="Stretch" SelectionChanged="Tier_SelectionChanged"><ComboBoxItem Content="Vortex · Schnell" Tag="vortex"/><ComboBoxItem Content="Zenith · Ausgewogen" Tag="zenith"/><ComboBoxItem Content="Apex · Anspruchsvoll" Tag="apex"/></ComboBox>
       <ComboBox x:Name="Effort" Header="Ausführlichkeit" SelectedIndex="1" HorizontalAlignment="Stretch"><ComboBoxItem Content="Low · Kurz" Tag="low"/><ComboBoxItem Content="Medium · Ausgewogen" Tag="medium"/><ComboBoxItem Content="High · Gründlich" Tag="high"/></ComboBox>
       <ComboBox x:Name="OutputMode" Header="Antwortformat" SelectedIndex="2" HorizontalAlignment="Stretch"><ComboBoxItem Content="Text" Tag="text"/><ComboBoxItem Content="Markdown" Tag="markdown"/><ComboBoxItem Content="Dynamic Canvas" Tag="canvas"/></ComboBox>
       <ComboBox x:Name="Model" Header="Modell" DisplayMemberPath="Name" HorizontalAlignment="Stretch" SelectionChanged="Model_SelectionChanged"/>
       <TextBlock Text="Effort steuert Umfang und Ausgabelimit. Die Modelle laufen über Cloudflare Workers AI." FontSize="12" Opacity="0.65" TextWrapping="Wrap"/>
      </StackPanel></Flyout></Button.Flyout>
     </Button>
     <Button Grid.Column="2" Content="◐" AutomationProperties.Name="Helles oder dunkles Design" Click="Theme_Click" Background="Transparent" BorderThickness="0"/>
    </Grid>
    <Grid Grid.Row="1" MaxWidth="880" HorizontalAlignment="Stretch">
     <StackPanel x:Name="Welcome" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" Margin="16"><TextBlock Text="Raum für deine Gedanken." FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/><TextBlock Text="Fragen klären. Ideen entwickeln. Neues verstehen." FontSize="16" Opacity="0.65" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel>
     <ListView x:Name="Messages" SelectionMode="None" Background="Transparent" BorderThickness="0"><ListView.ItemTemplate><DataTemplate><StackPanel Spacing="12" Padding="6,18"><TextBlock Text="{Binding DisplayRole}" FontSize="12" FontWeight="SemiBold" Opacity="0.55"/><local:MessageView/><local:CanvasView/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
    </Grid>
    <InfoBar x:Name="Status" Grid.Row="2" MaxWidth="880" IsOpen="False" IsClosable="True" Severity="Informational"><InfoBar.ActionButton><Button x:Name="ConnectButton" Content="Erneut verbinden" Click="Connect_Click"/></InfoBar.ActionButton></InfoBar>
    <Grid Grid.Row="3" MaxWidth="880" HorizontalAlignment="Stretch" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border CornerRadius="18" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{ThemeResource ControlFillColorDefaultBrush}" Padding="12">
      <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBox x:Name="Composer" PlaceholderText="Frag Lemon …" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="180" BorderThickness="0" Background="Transparent" KeyDown="Composer_KeyDown" AutomationProperties.Name="Nachricht an Lemon"/>
       <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ConnectionLabel" Text="Verbindung wird hergestellt …" FontSize="12" Opacity="0.6" VerticalAlignment="Center" TextWrapping="Wrap"/><Button x:Name="Stop" Grid.Column="1" Content="■" Visibility="Collapsed" IsEnabled="False" AutomationProperties.Name="Antwort stoppen" Click="Stop_Click"/><Button x:Name="Send" Grid.Column="2" Content="↑" AutomationProperties.Name="Nachricht senden" Click="Send_Click"/></Grid>
      </Grid>
     </Border>
     <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14"><Button x:Name="Regenerate" Content="Erneut generieren" Click="Regenerate_Click" Background="Transparent" BorderThickness="0" FontSize="12"/><TextBlock Text="Lemon kann Fehler machen." VerticalAlignment="Center" FontSize="12" Opacity="0.55"/></StackPanel>
    </Grid>
   </Grid>
  </SplitView>
 </Grid>
</Window>

